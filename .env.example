# ─────────────────────────────────────────────────────────────────────────
# MediCure AI — copy to .env and fill in. Nothing here has a secret default.
#
# The system runs with NONE of these set. Retrieval, price verification,
# alternatives and calibrated abstention are all local and deterministic;
# only the natural-language explanation needs AWS.
# ─────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────────────────────
# Atlas M0 (free) is sufficient: the 253k-row index lives in the application
# as a build artifact, not in the database.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=medicure

# ── Authentication ───────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=

# ── Amazon Bedrock ───────────────────────────────────────────────────────
# Set false to run the entire stack with no AWS account.
ENABLE_BEDROCK=true
AWS_REGION=us-east-1

# Verify these exist before deploying:
#   aws bedrock list-foundation-models --region us-east-1
# The us. prefix selects a cross-region inference profile.
# Amazon Nova by default. Nova and Titan are FIRST-PARTY AWS services; Claude,
# Llama and Mistral come via AWS Marketplace subscriptions, which is what needs
# a valid payment method on the account. On an account without one, the
# first-party models work and the others fail with INVALID_PAYMENT_INSTRUMENT.
#
# Find out what YOUR account can actually invoke:
#   bash infra/aws/probe_models.sh
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_FAST_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ALWAYS set explicitly. Leaving maxTokens unset makes Bedrock reserve the
# model's maximum against your quota, producing ThrottlingException at request
# rates that look nowhere near the limit.
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.0

# Contextual grounding is what mechanically blocks an explanation that strays
# from the retrieved facts. Create with `aws bedrock create-guardrail`,
# grounding and relevance thresholds at 0.7, denied topics for diagnosis and
# dosage-change advice.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ── Images ───────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=12582912
# False keeps the "no long-term storage of medical images" claim true rather
# than aspirational.
STORE_UPLOADS=false
