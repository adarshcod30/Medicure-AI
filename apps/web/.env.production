# Build-time configuration for the production bundle.
#
# Vite inlines VITE_* variables at build time, so this must be set before
# `vite build` runs -- it cannot be changed by a runtime environment variable
# on Vercel afterwards. Committing it keeps the production build reproducible
# from a clean clone rather than depending on dashboard state someone has to
# remember to configure.
#
# Safe to commit: this is a public endpoint. No credential is ever baked into
# the frontend bundle -- the AWS keys, JWT secret and Mongo URI live only in
# the API's Secret Manager entries.
VITE_API_URL=https://medicure-api-607129285071.asia-south1.run.app/v1
