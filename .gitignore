# ── Data ─────────────────────────────────────────────────────────────────
# Everything here is either large, derived, or not ours to redistribute.
# Each is reproducible; see infra/deploy/README.md for what a fresh
# deployment needs.
#
#   data/raw/         source imagery and third-party dataset releases
#   data/artifacts/   the lexical index      -> scripts/build_index.py
#                     the dense vectors      -> scripts/build_embeddings.py
#   interactions/     the DDInter table      -> scripts/ingest_interactions.py
#
# data/processed/*.csv IS tracked: those are the catalogue sources the index
# is built from, and the project is not useful without them.
data/raw/
data/artifacts/
data/processed/interactions/
data/processed/*.csv.gz
data/processed/*.superseded-*

# ── DIP stage dumps (--dump-stages output) ───────────────────────────────
out/
stages/

# Local virtualenv
.venv/
